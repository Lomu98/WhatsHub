{
  "name": "whatshub",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsHub — WhatsApp group bot + admin dashboard monorepo",
  "workspaces": [
    "bot",
    "dashboard"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n bot,dash -c cyan,magenta \"npm:dev:bot\" \"npm:dev:dashboard\"",
    "dev:bot": "npm run dev --workspace bot",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "build": "npm run build --workspace bot && npm run build --workspace dashboard",
    "build:bot": "npm run build --workspace bot",
    "build:dashboard": "npm run build --workspace dashboard",
    "start:bot": "npm run start --workspace bot",
    "start:dashboard": "npm run start --workspace dashboard",
    "typecheck": "npm run typecheck --workspace bot && npm run typecheck --workspace dashboard",
    "lint": "npm run lint --workspace dashboard"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
