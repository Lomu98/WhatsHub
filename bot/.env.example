# ============================================================================
# WhatsHub Bot — copia questo file in `bot/.env` e compila i valori
# ============================================================================

# --- Firebase Admin SDK -----------------------------------------------------
# Console Firebase > Impostazioni progetto > Account di servizio > Genera nuova chiave
FIREBASE_PROJECT_ID=whatshub-xxxxx
FIREBASE_DATABASE_URL=https://whatshub-xxxxx-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@whatshub-xxxxx.iam.gserviceaccount.com
# La private key va tra virgolette doppie, con i \n letterali (come nel JSON scaricato)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Alternativa: percorso al file JSON del service account (se valorizzata,
# ha priorità sulle tre variabili qui sopra)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# --- Bot --------------------------------------------------------------------
BOT_NAME=WhatsHub
BOT_COMMAND_PREFIX=!

# Dove viene salvato il BACKUP compresso della sessione WhatsApp (RemoteAuth).
# Non cancellarla: se la elimini dovrai rifare la scansione del QR. Il profilo
# Chromium vero e proprio vive altrove, su disco veloce/effimero (vedi
# whatsapp/client.ts) — qui arriva solo uno zip periodico.
WA_SESSION_PATH=./.wwebjs_auth
WA_CLIENT_ID=whatshub

# --- Cron compleanni --------------------------------------------------------
TZ_NAME=Europe/Rome
# Ogni mattina alle 09:00 (formato cron standard: min ora giorno mese giorno-settimana)
BIRTHDAY_CRON=0 9 * * *
# ID dei gruppi a cui inviare gli auguri automatici, separati da virgola.
# Es: 120363011111111111@g.us,120363022222222222@g.us
# Se vuoto, il bot usa i gruppi marcati come `notify: true` su /groups nel DB.
NOTIFY_GROUP_IDS=

# --- Sicurezza / avanzate ---------------------------------------------------
# Abilita i comandi dinamici di tipo `script` (eseguiti in sandbox vm).
# Lascia `false` a meno che tu non sia l'unico ad avere accesso alla dashboard.
ALLOW_SCRIPT_COMMANDS=false

# Fa rispondere il bot anche ai TUOI messaggi.
# Serve se il bot gira sul tuo stesso numero: WhatsApp non consegna alla
# libreria i messaggi inviati dall'account su cui e' collegata, quindi senza
# questa opzione non potresti mai usare i comandi tu stesso.
# Se il bot ha un numero dedicato, lascia pure `false`.
ALLOW_SELF_COMMANDS=false

# Quante voci mantenere in /logs
LOG_RETENTION=100

# --- Versione di WhatsApp Web -----------------------------------------------
# `auto` lascia scegliere a whatsapp-web.js: e' quasi sempre la scelta giusta.
# Fissa una versione specifica SOLO se il watchdog nei log riporta
# `WWebJS=undefined`, che indica un'iniezione fallita per incompatibilita'.
# Elenco versioni: https://github.com/wppconnect-team/wa-version/tree/main/html
WA_WEB_VERSION=auto

# Puppeteer: metti `false` per vedere il browser (debug del login)
PUPPETEER_HEADLESS=true
# Se Chromium non viene scaricato automaticamente, indica un Chrome locale:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
