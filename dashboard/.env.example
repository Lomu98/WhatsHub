# ============================================================================
# WhatsHub Dashboard — copia questo file in `dashboard/.env.local`
# ----------------------------------------------------------------------------
# Questi valori li trovi in:
# Console Firebase > Impostazioni progetto > Le tue app > App web > SDK setup
#
# Sono valori PUBBLICI (finiscono nel bundle del browser): la protezione dei
# dati non dipende da loro ma dalle Realtime Database Rules — vedi
# `database.rules.json` nella root del repo.
# ============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=whatshub-xxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://whatshub-xxxxx-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=whatshub-xxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=whatshub-xxxxx.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Email autorizzate ad accedere alla dashboard (login Google), separate da
# virgola. Deve corrispondere a quanto scritto in `database.rules.json`,
# altrimenti chi entra dal login non riesce comunque a leggere/scrivere nulla.
NEXT_PUBLIC_ALLOWED_EMAILS=tuo-indirizzo@gmail.com
